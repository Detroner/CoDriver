{
  "name": "codriver",
  "version": "1.0.0",
  "description": "All-in-One Desktop GUI combining OpenCode CLI, OmniRoute AI Router, and GitHub Workspace Integration",
  "main": "dist/main/index.js",
  "author": "CoDriver Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "electron .",
    "dev:electron": "concurrently \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 && electron .\"",
    "package:win": "npm run build && npm run build:electron && electron-builder --win"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.2",
    "clsx": "^2.1.0",
    "dotenv": "^16.4.5",
    "get-port": "^7.1.0",
    "lucide-react": "^0.344.0",
    "node-fetch": "^3.3.2",
    "open": "^10.1.0",
    "simple-git": "^3.22.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  }
}
